$body = @{
    AppID  = 'online_test'
    Safe   = 'CCP-online_test'
    Object = 'clalitonlinetest1'
    Reason = 'test'
} | ConvertTo-Json -Compress

$response = Invoke-RestMethod `
    -Uri 'https://swtmksafe-web01.clalit.org.il/AIMWebService/api/Accounts' `
    -Method Post `
    -ContentType 'application/json' `
    -Body $body `
    -ErrorAction Stop

$response | Select-Object UserName, Address, Safe, Object
$response.Content
