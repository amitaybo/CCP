# Filename: Get-CCPPassword-Standalone.ps1
# Standalone example - retrieves a password from the Central Credential Provider with a REST POST.
# No dependencies: copy it to any machine and edit the variables below.
# Works on Windows PowerShell 5.1 and PowerShell 7+

# Configuration
$ccpUrl = "https://swtmksafe-web01.clalit.org.il" # Host name must match the CCP certificate
$appId = "CCP-Demo-App"
$safe = "CCP-Demo"
$userName = "reception" # Or use Object instead of UserName + Address
$address = "db.lab.local"
$windowsAuth = $false # $true when the CCP uses Windows Authentication
$skipCertCheck = $false # $true only in a lab with a self-signed certificate

# Windows PowerShell 5.1 does not use TLS 1.2 by default
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$params = @{
    Uri = "$($ccpUrl.TrimEnd('/'))/AIMWebService/api/Accounts"
    Method = 'POST'
    ContentType = 'application/json'
    Body = @{ AppID = $appId; Safe = $safe; UserName = $userName; Address = $address; Reason = 'Demo' } | ConvertTo-Json
    ErrorAction = 'Stop'
}
if ($windowsAuth) { $params.UseDefaultCredentials = $true }
if ($skipCertCheck) {
    Write-Host "Certificate check disabled - lab only" -ForegroundColor Yellow
    if ($PSVersionTable.PSVersion.Major -ge 6) { $params.SkipCertificateCheck = $true }
    else { [Net.ServicePointManager]::ServerCertificateValidationCallback = { $true } }
}

try {
    $response = Invoke-RestMethod @params
    Write-Host "Your password is:" $response.Content -ForegroundColor Green
} catch {
    # The CCP returns ErrorCode / ErrorMsg in the body - this is the useful part
    $status = [int]$_.Exception.Response.StatusCode
    $detail = $_.Exception.Message
    try {
        $ccpError = $_.ErrorDetails.Message | ConvertFrom-Json
        $detail = "$($ccpError.ErrorCode): $($ccpError.ErrorMsg)"
    } catch { }
    Write-Host "Request failed (HTTP $status) - $detail" -ForegroundColor Red
}
